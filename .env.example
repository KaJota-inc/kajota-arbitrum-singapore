# Kajota Mesh — Arbitrum Open House Singapore buildathon
#
# Copy to `.env` (gitignored) and fill before running deploy / verify / demo.
# All keys read by hardhat.config.ts via dotenv at config-load time.

# ---- Networks -----------------------------------------------------

# Arbitrum Sepolia public RPC. Swap to a managed Alchemy / QuickNode
# endpoint to avoid rate-limits during the dev loop.
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Robinhood Chain testnet — Arbitrum Orbit L2 (chainId 46630).
# ⚠ Mainnet is chainId 4663; do not paste a mainnet RPC here.
# Faucet: https://faucet.testnet.chain.robinhood.com/
# Bridge from Arbitrum Sepolia: https://portal.arbitrum.io/bridge
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# ---- Deployer EOA -------------------------------------------------

# Funded with ≥0.0001 Arbitrum Sepolia ETH (~0.00004 ETH actual cost
# at 0.02 gwei for the 2-contract deploy). Faucets:
#   - https://www.alchemy.com/faucets/arbitrum-sepolia
#   - https://faucet.quicknode.com/arbitrum/sepolia
#   - https://bridge.arbitrum.io  (bridge from Sepolia)
DEPLOYER_PRIVATE_KEY=0x...

# Optional. Defaults to the deployer EOA when unset. In production
# this is the Chainlink Functions consumer that fires release().
INITIAL_RELEASE_AUTH=

# ---- Etherscan / Arbiscan verify ----------------------------------

# Free key from https://arbiscan.io/myapikey — Etherscan V2 unified
# API accepts one key across every chain id.
ARBISCAN_API_KEY=

# ---- Demo (scripts/arbitrum-demo.sh) ------------------------------

# Buyer signs the approve + deposit txs. Needs ≥1 USDC + tiny ETH
# (~0.001 ETH covers all 4 demo steps). Use a throwaway burner —
# `cast wallet new` generates one in under a second.
BUYER_PRIVATE_KEY=0x...
